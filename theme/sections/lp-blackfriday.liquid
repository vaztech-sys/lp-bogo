{%- comment -%}
  Malbor Black Friday 2026 landing page: the Professional Line 60ml bottles at
  25% off, 35% off every bottle from five up, and one free SiO2 Top Sealant
  473ml with every bottle.

  What carries over from the earlier campaign pages, and why:

  1. The free item goes into the cart with the first bottle, in the same
     /cart/add.js call, with or without JavaScript. Shopify's automatic
     "buy X get Y" discount never adds the free item by itself; the
     September discount was used zero times because shoppers had to add the
     free item by hand.
  2. Prices and stock are live. Nothing on this page hardcodes a price, a
     quantity or a date.

  The page has two states, picked from the dates in the section settings
  (Florida time):

  - "soon":  before the start date. Full prices, the offer announced, a
             countdown to the start and Add to cart disabled.
  - "live":  between the dates. Discounted prices previewed, buttons active,
             a countdown to the end.

  After the end date it shows "soon" without dates, or "ended", per the
  `after_end` setting. The state is rendered here and re-checked in the
  browser by lp-blackfriday.js, so a cached page still flips on time.
{%- endcomment -%}

{{ 'lp-blackfriday.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,700;0,800;1,800;1,900&family=Poppins:wght@400;500;600&display=swap"
>

{%- liquid
  # ── Period ──────────────────────────────────────────────────────────────
  assign tz = section.settings.tz_offset | default: '-0500'
  assign now_ts = 'now' | date: '%s' | plus: 0

  assign start_ts = 0
  if section.settings.start_at != blank
    assign start_ts = section.settings.start_at | append: ' ' | append: tz | date: '%s' | plus: 0
  endif
  assign end_ts = 0
  if section.settings.end_at != blank
    assign end_ts = section.settings.end_at | append: ' ' | append: tz | date: '%s' | plus: 0
  endif
  # A date that did not parse comes back as text and turns into a small
  # number; treat anything before 2001 as "not set".
  if start_ts < 1000000000
    assign start_ts = 0
  endif
  if end_ts < 1000000000
    assign end_ts = 0
  endif

  assign state = 'soon'
  if start_ts > 0 and now_ts >= start_ts
    assign state = 'live'
  endif
  if end_ts > 0 and now_ts >= end_ts
    if section.settings.after_end == 'ended'
      assign state = 'ended'
    else
      assign state = 'over'
    endif
  endif

  assign period_short = section.settings.period_short
  assign period_long = section.settings.period_long

  # ── Free SiO2 Top Sealant ───────────────────────────────────────────────
  # A variant counts as in stock only if Shopify says it is available AND,
  # when Shopify tracks it, there is at least one on hand. Several of these
  # products are set to keep selling at zero, which would otherwise let the
  # page promise something that is not on the shelf.
  assign gift_std = section.settings.gift_standard
  assign gift_std_variant = gift_std.selected_or_first_available_variant | default: gift_std.variants.first
  assign gift_std_ok = false
  if gift_std_variant != blank and gift_std_variant.available
    assign gift_std_ok = true
    if gift_std_variant.inventory_management == 'shopify' and gift_std_variant.inventory_quantity < 1
      assign gift_std_ok = false
    endif
  endif

  assign gift_mar = section.settings.gift_marine
  assign gift_mar_variant = gift_mar.selected_or_first_available_variant | default: gift_mar.variants.first
  assign gift_mar_ok = false
  if gift_mar_variant != blank and gift_mar_variant.available
    assign gift_mar_ok = true
    if gift_mar_variant.inventory_management == 'shopify' and gift_mar_variant.inventory_quantity < 1
      assign gift_mar_ok = false
    endif
  endif

  assign gift_any_ok = false
  if gift_std_ok or gift_mar_ok
    assign gift_any_ok = true
  endif

  # One sealant per bottle, and never more than are on hand: the cap is the
  # tracked stock (unlimited when Shopify does not track it). The no-JS form
  # uses what is already in the cart to stay under the cap.
  assign gift_std_cap = 9999
  if gift_std_variant.inventory_management == 'shopify'
    assign gift_std_cap = gift_std_variant.inventory_quantity | at_least: 0
  endif
  assign gift_mar_cap = 9999
  if gift_mar_variant.inventory_management == 'shopify'
    assign gift_mar_cap = gift_mar_variant.inventory_quantity | at_least: 0
  endif

  assign gift_std_in_cart = 0
  assign gift_mar_in_cart = 0
  for item in cart.items
    if item.variant_id == gift_std_variant.id
      assign gift_std_in_cart = gift_std_in_cart | plus: item.quantity
    elsif item.variant_id == gift_mar_variant.id
      assign gift_mar_in_cart = gift_mar_in_cart | plus: item.quantity
    endif
  endfor
  if gift_std_in_cart >= gift_std_cap
    assign gift_std_room = false
  else
    assign gift_std_room = true
  endif
  if gift_mar_in_cart >= gift_mar_cap
    assign gift_mar_room = false
  else
    assign gift_mar_room = true
  endif

  assign product_blocks = section.blocks | where: 'type', 'product'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign terms = section.settings.terms | replace: '[period]', period_long | strip | newline_to_br | split: '<br />'

  assign gift_price = gift_std_variant.price | default: gift_mar_variant.price
-%}

<div
  class="lp-page"
  data-lp-page
  data-lp-state="{{ state }}"
  data-cart-open="false"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
>
  <p class="lp-visually-hidden" role="status" aria-live="polite" data-lp-live></p>

  {%- comment -%} ── Header ─────────────────────────────────────────────── {%- endcomment -%}
  <header class="lp-header">
    <div class="lp-header__inner">
      {% render 'lp-blackfriday-logo', url: '#lp-products' %}

      <nav class="lp-nav" aria-label="Landing page sections">
        <a href="#lp-products">SHOP</a>
        <a href="#lp-how-it-works">HOW IT WORKS</a>
        <a href="#lp-pickup">PICKUP</a>
      </nav>

      <div class="lp-header__actions">
        <button type="button" class="lp-cart-toggle" data-lp-open aria-label="Open cart">
          {% render 'lp-blackfriday-cart-icon' %}
          <span class="lp-cart-toggle__count" data-lp-count {% if cart.item_count == 0 %}hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
        </button>
        <a class="lp-btn lp-btn--sm" href="#lp-products">{{ section.settings.header_cta }}</a>
      </div>
    </div>
  </header>

  {%- comment -%} ── Hero ───────────────────────────────────────────────── {%- endcomment -%}
  <section class="lp-hero" aria-labelledby="lp-hero-title">
    <div class="lp-hero__glow" aria-hidden="true"></div>

    <h1 class="lp-hero__title" id="lp-hero-title">
      <span class="lp-hero__black">BLACK</span>
      <span class="lp-hero__friday">FRIDAY</span>
    </h1>

    <div class="lp-hero__stage">
      <div class="lp-stage" aria-hidden="true">
        <div class="lp-stage__light"></div>
        <div class="lp-stage__items">
          {%- for i in (1..3) -%}
            {%- assign key = 'hero_product_' | append: i -%}
            {%- assign hero_product = section.settings[key] -%}
            {%- if hero_product != blank and hero_product.featured_image -%}
              <div class="lp-stage__item lp-stage__item--{{ i }}">
                {%- if i == 2 -%}
                  {% render 'lp-blackfriday-bottle', image: hero_product.featured_image, alt: '', width: 900, widths: '450,700,900', sizes: '(max-width: 760px) 240px, 440px', loading: 'eager', priority: true %}
                {%- else -%}
                  {% render 'lp-blackfriday-bottle', image: hero_product.featured_image, alt: '', width: 700, widths: '350,520,700', sizes: '(max-width: 760px) 180px, 330px', loading: 'eager', priority: true %}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="lp-stage__pedestal"></div>
      </div>

      {%- if period_short != blank -%}
        <p class="lp-seal" data-lp-hide-when="over">
          <span>{{ period_short | newline_to_br }}</span>
        </p>
      {%- endif -%}
    </div>

    <div class="lp-hero__copy">
      <p class="lp-hero__offer">
        {{ section.settings.offer_line }}
        {%- if gift_any_ok %} <span class="lp-hero__offer-gift">· {{ section.settings.offer_gift }}</span>{% endif -%}
      </p>

      {%- unless gift_any_ok -%}
        <p class="lp-notice">{{ section.settings.gift_soldout_text }}</p>
      {%- endunless -%}

      <p class="lp-ended" data-lp-only="ended">{{ section.settings.ended_text }}</p>

      <div
        class="lp-countdown"
        data-lp-countdown
        data-lp-hide-when="over ended"
        {% if start_ts == 0 %}hidden{% endif %}
      >
        <p class="lp-countdown__label">
          <span data-lp-only="soon">{{ section.settings.countdown_soon }}</span>
          <span data-lp-only="live">{{ section.settings.countdown_live }}</span>
        </p>
        <p class="lp-countdown__clock" aria-hidden="true">
          <span><b data-lp-cd="d">--</b><small>days</small></span>
          <span><b data-lp-cd="h">--</b><small>hrs</small></span>
          <span><b data-lp-cd="m">--</b><small>min</small></span>
          <span><b data-lp-cd="s">--</b><small>sec</small></span>
        </p>
        <p class="lp-countdown__when" data-lp-hide-when="over ended">{{ period_long }}</p>
      </div>

      <a class="lp-btn lp-btn--wide" href="#lp-products">{{ section.settings.hero_cta }}</a>
    </div>
  </section>

  {%- comment -%} ── Ribbon ─────────────────────────────────────────────── {%- endcomment -%}
  <div class="lp-ribbon" aria-hidden="true">
    <p>
      {%- for i in (1..8) -%}
        <span>BLACK FRIDAY</span><span class="lp-ribbon__star">✦</span>
        {%- if period_short != blank -%}
          <span data-lp-hide-when="over ended">{{ period_short | newline_to_br | replace: '<br />', ' ' | strip_newlines }}</span><span class="lp-ribbon__star" data-lp-hide-when="over ended">✦</span>
        {%- endif -%}
      {%- endfor -%}
    </p>
  </div>

  {%- comment -%} ── How it works ───────────────────────────────────────── {%- endcomment -%}
  <section class="lp-section" id="lp-how-it-works">
    <div class="lp-section__head">
      <p class="lp-eyebrow">{{ section.settings.steps_eyebrow }}</p>
      <h2 class="lp-h2">{{ section.settings.steps_heading }}</h2>
    </div>

    <ol class="lp-steps">
      {%- for block in step_blocks -%}
        <li class="lp-step" {{ block.shopify_attributes }}>
          <span class="lp-step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <p class="lp-step__title">{{ block.settings.title }}</p>
          {%- if block.settings.body != blank -%}<p class="lp-step__body">{{ block.settings.body }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </section>

  {%- comment -%} ── Products ───────────────────────────────────────────── {%- endcomment -%}
  <section class="lp-section lp-section--products" id="lp-products">
    <div class="lp-section__head">
      <p class="lp-eyebrow">{{ section.settings.products_eyebrow }}</p>
      <h2 class="lp-h2">{{ section.settings.products_heading }}</h2>
      <p class="lp-body">{{ section.settings.products_body }}</p>
    </div>

    <nav class="lp-filter" aria-label="Filter products" data-lp-filters>
      <a href="#lp-products" class="lp-filter__btn" data-lp-filter="all" aria-current="true">All</a>
      <a href="#lp-group-boat" class="lp-filter__btn" data-lp-filter="boat">Boat</a>
      <a href="#lp-group-car" class="lp-filter__btn" data-lp-filter="car">Car</a>
      <a href="#lp-group-interior" class="lp-filter__btn" data-lp-filter="interior">Interior</a>
    </nav>

    <div class="lp-groups" data-lp-groups data-lp-active="all">
      {%- assign groups = 'boat,car,interior' | split: ',' -%}
      {%- for group in groups -%}
        {%- liquid
          case group
            when 'boat'
              assign group_title = section.settings.group_boat_title
              assign group_body = section.settings.group_boat_body
              assign group_key = 'in_boat'
            when 'car'
              assign group_title = section.settings.group_car_title
              assign group_body = section.settings.group_car_body
              assign group_key = 'in_car'
            else
              assign group_title = section.settings.group_interior_title
              assign group_body = section.settings.group_interior_body
              assign group_key = 'in_interior'
          endcase
        -%}
        <div class="lp-group" id="lp-group-{{ group }}" data-lp-group="{{ group }}">
          <div class="lp-group__head">
            <h3 class="lp-h3">{{ group_title }}</h3>
            {%- if group_body != blank -%}<p class="lp-body">{{ group_body }}</p>{%- endif -%}
          </div>

          <div class="lp-products">
            {%- for block in product_blocks -%}
              {%- if block.settings[group_key] -%}
                {% render 'lp-blackfriday-card',
                  block: block,
                  state: state,
                  gift_std_variant: gift_std_variant,
                  gift_std_ok: gift_std_ok,
                  gift_mar_variant: gift_mar_variant,
                  gift_mar_ok: gift_mar_ok,
                  gift_std_room: gift_std_room,
                  gift_mar_room: gift_mar_room,
                  soon_label: section.settings.soon_button,
                  ended_label: section.settings.ended_button
                %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ── Free sealant ───────────────────────────────────────── {%- endcomment -%}
  <section class="lp-gift" id="lp-gift" aria-labelledby="lp-gift-title">
    <div class="lp-gift__copy">
      <p class="lp-eyebrow">{{ section.settings.gift_eyebrow }}</p>
      <h2 class="lp-h2" id="lp-gift-title">{{ section.settings.gift_heading }}</h2>
      {%- if gift_any_ok -%}
        <p class="lp-gift__tag">{{ section.settings.gift_tag }}</p>
        <p class="lp-body">{{ section.settings.gift_body }}</p>
      {%- else -%}
        <p class="lp-notice">{{ section.settings.gift_soldout_text }}</p>
      {%- endif -%}
    </div>

    <ul class="lp-gift__items">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign g_product = gift_std
            assign g_ok = gift_std_ok
            assign g_label = 'Standard'
            assign g_fx = 0.282
            assign g_fy = 0.176
            assign g_fw = 0.38
            assign g_fh = 0.687
          else
            assign g_product = gift_mar
            assign g_ok = gift_mar_ok
            assign g_label = 'Marine'
            assign g_fx = 0.282
            assign g_fy = 0.187
            assign g_fw = 0.35
            assign g_fh = 0.626
          endif
        -%}
        {%- if g_product != blank -%}
          <li class="lp-gift__item{% unless g_ok %} lp-gift__item--out{% endunless %}">
            <div class="lp-gift__media">
              {%- comment -%}
                The two sealant photos frame their bottles differently from
                the 60ml ones and from each other; measured on the store's
                photos (fractions of the 600x800 image).
              {%- endcomment -%}
              {% render 'lp-blackfriday-bottle',
                image: g_product.featured_image,
                alt: g_product.title,
                width: 600,
                widths: '300,450,600',
                sizes: '(max-width: 760px) 160px, 320px',
                frame_x: g_fx,
                frame_y: g_fy,
                frame_w: g_fw,
                frame_h: g_fh
              %}
            </div>
            <p class="lp-gift__name">{{ g_product.title }}</p>
            <p class="lp-gift__kind">{{ g_label }}</p>
            {%- if g_ok -%}
              <p class="lp-gift__price"><s>{{ g_product.price | money_without_trailing_zeros }}</s> <strong>FREE</strong></p>
            {%- else -%}
              <p class="lp-gift__price lp-gift__price--out">Sold out</p>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </section>

  {%- comment -%} ── Pickup ─────────────────────────────────────────────── {%- endcomment -%}
  <section class="lp-section" id="lp-pickup">
    <div class="lp-section__head">
      <p class="lp-eyebrow">{{ section.settings.pickup_eyebrow }}</p>
      <h2 class="lp-h2">{{ section.settings.pickup_heading }}</h2>
      <p class="lp-body">{{ section.settings.pickup_body }}</p>
    </div>

    <div class="lp-pickup">
      {%- for i in (1..2) -%}
        {%- liquid
          assign p_name = 'pickup_' | append: i | append: '_name'
          assign p_addr = 'pickup_' | append: i | append: '_address'
          assign p_note = 'pickup_' | append: i | append: '_note'
        -%}
        {%- if section.settings[p_name] != blank -%}
          <div class="lp-pickup__place">
            <p class="lp-pickup__name">{{ section.settings[p_name] }}</p>
            <p class="lp-pickup__addr">{{ section.settings[p_addr] | newline_to_br }}</p>
            {%- if section.settings[p_note] != blank -%}<p class="lp-pickup__note">{{ section.settings[p_note] }}</p>{%- endif -%}
            <a
              class="lp-pickup__map"
              href="https://www.google.com/maps/search/?api=1&query={{ section.settings[p_addr] | strip_newlines | url_encode }}"
              target="_blank"
              rel="noopener"
            >Open in Maps</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ── Fine print ─────────────────────────────────────────── {%- endcomment -%}
  <section class="lp-section lp-section--terms" id="lp-terms">
    <div class="lp-section__head">
      <p class="lp-eyebrow">{{ section.settings.terms_eyebrow }}</p>
      <h2 class="lp-h2">{{ section.settings.terms_heading }}</h2>
    </div>

    <ul class="lp-terms">
      {%- for term in terms -%}
        {%- assign line = term | strip_html | strip -%}
        {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="lp-contact">
      <p>{{ section.settings.contact_heading }}</p>
      <p class="lp-contact__links">
        {%- if section.settings.contact_phone != blank -%}
          <a href="tel:+1{{ section.settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">
            {{- section.settings.contact_phone -}}
          </a>
        {%- endif -%}
        {%- if section.settings.contact_email != blank -%}
          <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
        {%- endif -%}
      </p>
    </div>
  </section>

  {%- comment -%} ── Footer ─────────────────────────────────────────────── {%- endcomment -%}
  <footer class="lp-footer">
    {% render 'lp-blackfriday-logo', url: section.settings.logo_url %}
    <p>{{ section.settings.footer_tagline }}</p>
    <div class="lp-footer__bar">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <div class="lp-footer__legal">
        {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
        {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
      </div>
    </div>
  </footer>

  {%- comment -%} ── Cart drawer ────────────────────────────────────────── {%- endcomment -%}
  <div class="lp-drawer__backdrop" data-lp-backdrop></div>

  <aside class="lp-drawer" data-lp-drawer role="dialog" aria-modal="true" aria-label="Your cart">
    <div class="lp-drawer__head">
      <p>Your Cart</p>
      <button type="button" class="lp-drawer__close" data-lp-close aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="lp-progress" data-lp-progress hidden></div>
    <p class="lp-drawer__error" data-lp-error hidden></p>
    <div class="lp-drawer__items" data-lp-items></div>
    <div class="lp-drawer__foot" data-lp-foot hidden></div>
  </aside>
</div>

{%- comment -%}
  Everything lp-blackfriday.js needs, rendered from live data. Bottle ids are
  the product blocks on this page; the two sealant ids are the free item.
{%- endcomment -%}
<script type="application/json" data-lp-config>
  {
    "state": {{ state | json }},
    "start": {{ start_ts | times: 1000 }},
    "end": {{ end_ts | times: 1000 }},
    "afterEnd": {{ section.settings.after_end | default: 'soon' | json }},
    "tier": { "min": 5, "base": 25, "bulk": 35 },
    "bottles": [
      {%- assign first_bottle = true -%}
      {%- for block in product_blocks -%}
        {%- assign b_product = block.settings.product -%}
        {%- assign b_variant = b_product.selected_or_first_available_variant | default: b_product.variants.first -%}
        {%- if b_variant != blank -%}
          {%- unless first_bottle %},{% endunless -%}
          {"id": {{ b_variant.id }}, "marine": {% if b_product.handle contains 'marine' %}true{% else %}false{% endif %}}
          {%- assign first_bottle = false -%}
        {%- endif -%}
      {%- endfor -%}
    ],
    "gift": {
      "standard": {% if gift_std_variant != blank %}{{ gift_std_variant.id }}{% else %}null{% endif %},
      "standardOk": {{ gift_std_ok }},
      "standardMax": {% if gift_std_cap == 9999 %}null{% else %}{{ gift_std_cap }}{% endif %},
      "marine": {% if gift_mar_variant != blank %}{{ gift_mar_variant.id }}{% else %}null{% endif %},
      "marineOk": {{ gift_mar_ok }},
      "marineMax": {% if gift_mar_cap == 9999 %}null{% else %}{{ gift_mar_cap }}{% endif %}
    },
    "text": {
      "soonButton": {{ section.settings.soon_button | json }},
      "endedButton": {{ section.settings.ended_button | json }}
    }
  }
</script>

<script src="{{ 'lp-blackfriday.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Black Friday landing page",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Period" },
    {
      "type": "paragraph",
      "content": "Dates use the format YYYY-MM-DD HH:MM, in Florida time. Before the start the page shows full prices, a countdown and disabled buttons. Keep these dates the same as the automatic discounts."
    },
    { "type": "text", "id": "start_at", "label": "Offer starts", "default": "2026-11-27 00:00", "info": "Leave empty to keep the page in \"coming soon\" with no countdown." },
    { "type": "text", "id": "end_at", "label": "Offer ends", "default": "2026-11-30 23:59", "info": "Leave empty for no end date." },
    {
      "type": "select",
      "id": "tz_offset",
      "label": "Florida time offset",
